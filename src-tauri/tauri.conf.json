{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Econote",
  "version": "../package.json",
  "identifier": "com.ecovacs.ticketnotes",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:8001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Econote",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0QjIxMkE5NDRDN0RDMjQKUldRazNNZEVxUkt5SkVWVHlWU1hGZ1JaT01MWVk4OTBwN0RnemYvb0V5M01IQ1dXUGxuSVJZa3EK",
      "endpoints": [
        "https://github.com/susulliang/note-master/releases/latest/download/latest.json"
      ]
    }
  }
}
