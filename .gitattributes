# Enforce consistent line endings across platforms
* text=auto eol=lf

# Explicitly mark shell scripts as LF (won't run on Windows with CRLF shebang)
*.sh text eol=lf

# Hook scripts (POSIX sh) must stay LF
.githooks/pre-commit text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pyc binary
*.zip binary
