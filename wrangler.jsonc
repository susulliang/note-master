{
  // Cloudflare Workers deploy config — Worker serving the built SPA (static
  // assets) plus a small API for self-test score submissions (D1).
  // Deploy with:  npm run deploy:workers   (builds standalone bundle
  // to dist/client, then `wrangler deploy`). Preview locally: npm run preview:workers
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-master",
  "compatibility_date": "2026-09-29",
  // Worker entry — handles the self-test result API; everything else is served from assets.
  "main": "worker/index.ts",
  // Self-test score submissions (eco-test database).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eco-test",
      "database_id": "046382b4-8134-46f8-a6ed-6316ed422f09"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/api/*"],
    // Serve index.html for unknown routes (SPA) — parity with Vercel rewrites.
    "not_found_handling": "single-page-application",
    // Default html_handling ("auto-trailing-slash") gives cleanUrls behaviour.
    "html_handling": "auto-trailing-slash"
  }
}
