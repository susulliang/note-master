{
  // Cloudflare Workers deploy config — Worker serving the built SPA (static
  // assets) plus tool APIs backed by the shared eco-data D1 database.
  // Deploy with:  npm run deploy:workers   (builds standalone bundle
  // to dist/client, then `wrangler deploy`). Preview locally: npm run preview:workers
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-master",
  "compatibility_date": "2026-09-29",
  // Worker entry — handles the self-test result API; everything else is served from assets.
  "main": "worker/index.ts",
  // Tool data (keyword alerts, self-test scores, and future tools).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eco-data",
      "database_id": "3a58e825-e384-44ae-9b7b-7d8466d3f460",
      "migrations_dir": "migrations"
    }
  ],
  // R2 copy of the knowledge base (kind/id.md per D1 kb_documents row) —
  // feeds the Cloudflare AI Search "Ask" instance.
  "r2_buckets": [
    {
      "binding": "KB_BUCKET",
      "bucket_name": "eco-kb"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMMUNE_ROOM", "class_name": "CommuneRoom" },
      { "name": "ROSTER_ROOM", "class_name": "RosterRoom" }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "migrations": [
    { "tag": "commune-room-v1", "new_sqlite_classes": ["CommuneRoom"] },
    { "tag": "roster-room-v1", "new_sqlite_classes": ["RosterRoom"] }
  ],
  "assets": {
    "directory": "./dist/client",
    // Binding lets the worker fetch bundled static files (e.g. app photo
    // binaries) during the R2 knowledge-base export.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/assets/*", "/", "/index.html"],
    // Serve index.html for unknown routes (SPA) — parity with Vercel rewrites.
    "not_found_handling": "single-page-application",
    // Default html_handling ("auto-trailing-slash") gives cleanUrls behaviour.
    "html_handling": "auto-trailing-slash"
  }
}
